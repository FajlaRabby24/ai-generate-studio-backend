model BackgroundRemove {
    id          String           @id @default(uuid())
    generatedId String
    status      GenerationStatus @default(PENDING)
    imageUrl    String
    outputUrls  String // final result URLs (ModelsLab returns an array)
    isPublic    Boolean          @default(true) // for community gallery
    isFeatured  Boolean          @default(false) // for landing page showcase
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt

    generated Generated @relation(fields: [generatedId], references: [id], onDelete: Cascade)

    @@map("background_remove")
}
