model ChatHistory {
  id            String   @id @default(uuid())
  userId        String
  chatHistoryId String
  prompt        String
  promptAns     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatHistoryId])
  @@map("chat_history")
}
