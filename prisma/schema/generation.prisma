model Generation {
  id           String           @id @default(uuid())
  userId       String
  type         GenerationType
  status       GenerationStatus @default(PENDING)
  prompt       String
  inputUrl     String?                              // for image input types
  outputUrls   String[]                             // final result URLs (ModelsLab returns an array)
  fetchUrl     String?                              // ModelsLab fetch_result URL
  model        String?                              // which AI model was used
  settings     Json?                                // width, height, steps, etc.
  errorMsg     String?
  isPublic     Boolean          @default(false)     // for community gallery
  isFeatured   Boolean          @default(false)     // for landing page showcase
  isDeleted    Boolean          @default(false)     // soft delete
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("generations")
}
